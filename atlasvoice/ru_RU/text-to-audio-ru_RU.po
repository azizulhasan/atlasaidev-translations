#: admin/js/build/chunks/tab-highlight.5d733dfd1bbfeb49.chunk.js:2
#: production/text-to-audio/admin/js/build/chunks/tab-highlight.5d733dfd1bbfeb49.chunk.js:2
#: src/dashboard/components/dashboard/highlight/Highlight.js:288
msgid "Softer background painted behind the whole sentence being read."
msgstr "Более мягкий фон за всем озвучиваемым предложением."

#: admin/js/build/chunks/tab-highlight.5d733dfd1bbfeb49.chunk.js:2
#: production/text-to-audio/admin/js/build/chunks/tab-highlight.5d733dfd1bbfeb49.chunk.js:2
#: src/dashboard/components/dashboard/highlight/Highlight.js:302
msgid "Dim the rest of the article"
msgstr "Приглушать остальной текст статьи"

#: admin/js/build/chunks/tab-highlight.5d733dfd1bbfeb49.chunk.js:2
#: production/text-to-audio/admin/js/build/chunks/tab-highlight.5d733dfd1bbfeb49.chunk.js:2
