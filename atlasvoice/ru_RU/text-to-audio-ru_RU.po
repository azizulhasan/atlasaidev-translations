#: admin/js/build/chunks/tab-highlight.5d733dfd1bbfeb49.chunk.js:2
#: production/text-to-audio/admin/js/build/chunks/tab-highlight.5d733dfd1bbfeb49.chunk.js:2
#: src/dashboard/components/dashboard/highlight/Highlight.js:252
msgid "Word highlight color"
msgstr "Цвет подсветки слова"

#: admin/js/build/chunks/tab-highlight.5d733dfd1bbfeb49.chunk.js:2
#: production/text-to-audio/admin/js/build/chunks/tab-highlight.5d733dfd1bbfeb49.chunk.js:2
#: src/dashboard/components/dashboard/highlight/Highlight.js:254
