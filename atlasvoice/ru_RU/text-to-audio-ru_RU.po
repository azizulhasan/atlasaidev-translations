#: production/text-to-audio/admin/js/build/chunks/tab-highlight.5d733dfd1bbfeb49.chunk.js:2
#: src/dashboard/components/dashboard/highlight/Highlight.js:237
msgid "Sentence only (recommended)"
msgstr "Только предложение (рекомендуется)"

#: admin/js/build/chunks/tab-highlight.5d733dfd1bbfeb49.chunk.js:2
#: production/text-to-audio/admin/js/build/chunks/tab-highlight.5d733dfd1bbfeb49.chunk.js:2
#: src/dashboard/components/dashboard/highlight/Highlight.js:238
msgid "Word only"
msgstr "Только слово"

#: admin/js/build/chunks/tab-highlight.5d733dfd1bbfeb49.chunk.js:2
#: production/text-to-audio/admin/js/build/chunks/tab-highlight.5d733dfd1bbfeb49.chunk.js:2
#: src/dashboard/components/dashboard/highlight/Highlight.js:239
msgid "Word + Sentence"
