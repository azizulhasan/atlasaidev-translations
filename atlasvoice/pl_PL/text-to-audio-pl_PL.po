msgid "Highlight the word and/or sentence being spoken while the post is read aloud."
msgstr "Podświetlaj wypowiadane słowo lub zdanie w trakcie odczytywania wpisu."

#: admin/js/build/chunks/tab-highlight.5d733dfd1bbfeb49.chunk.js:2
