#: src/dashboard/components/dashboard/docs/Docs.js:59
msgid "Browser and device support varies, so available voices and languages may differ between desktop and mobile devices."
msgstr "Mức hỗ trợ khác nhau tùy trình duyệt và thiết bị, nên giọng đọc và ngôn ngữ khả dụng có thể khác nhau giữa máy tính và thiết bị di động."

